rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only Google accounts and the shared demo account may use app data.
    // Email/password accounts created by bots get no access.
    // Replace DEMO_UID with the demo account's UID from Authentication > Users.
    function isAppUser() {
      return request.auth != null &&
        (request.auth.token.firebase.sign_in_provider == "google.com" ||
         request.auth.uid == "gJjHSsucBwfWieN1hWd1sHRndf52");
    }

    function isOwner(uid) {
      return isAppUser() && request.auth.uid == uid;
    }

    // User profile, timezones and plan.
    // plan and limits can only be changed from the Firebase console or a server.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid) &&
        request.resource.data.plan == "free" &&
        request.resource.data.limits.maxTimezones == 3;

      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["plan", "limits"]);

      allow delete: if false;
    }

    // Meetings collection - users can manage their own meetings
    match /meetings/{meetingId} {
      allow read: if isAppUser() &&
                   resource.data.userId == request.auth.uid;

      allow create: if isAppUser() &&
                     request.resource.data.userId == request.auth.uid;

      allow update: if isAppUser() &&
                     resource.data.userId == request.auth.uid;

      allow delete: if isAppUser() &&
                     resource.data.userId == request.auth.uid;
    }
  }
}
